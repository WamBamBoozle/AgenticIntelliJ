#!/usr/bin/env python3
"""bench: open, save, restore and prune benches, so IntelliJ can restart without losing sessions.

A bench is a project's IntelliJ window together with the Claude sessions in its
terminal tabs.

Usage:
  bench open [--dry-run] <project> [-- claude args]
      Start a bench: open the project in IntelliJ and resume the sessions
      saved for it. With nothing saved, start a new session there named
      after the directory, with the claude args given, or else
      $BENCH_CLAUDE_ARGS.
  bench save [--dry-run] [--force] [project]
      Save every bench: record every Claude session running in an IntelliJ
      terminal, stop them, and quit IntelliJ. Refuses while a session is busy, unless --force.
      With a project: save just that bench, the project's window and the
      sessions in it. Records only those sessions and closes only that
      window (File > Close Project); IntelliJ and the other benches keep running.
  bench restore [--dry-run] [project]
      Restore every bench: start IntelliJ (through the intellij script beside
      this one) with each recorded project and resume each session, with its
      original flags, in a terminal there.
      With a project: reopen that bench and resume its sessions, from its own
      save or from the whole-IDE save, whichever is newer.
  bench prune [--dry-run]
      Drop saved sessions whose directory no longer exists, and project saves
      left with none.
  bench show
      List the sessions running now and the ones saved; "gone" marks a saved
      session whose directory no longer exists.

A project is a directory, or a name: a saved or running session's -n name, or
the name of a saved session's directory.

State lives in ~/.cache/bench. The first run moves the saves from
~/.cache/intellij-sessions and the queue from ~/.cache/load-project/pending.
intellij-sessions, beside this script, still runs bench.

How restore and open work: each session's command is queued for its directory
in ~/.cache/bench/pending. IntelliJ reopens its projects and their terminal
tabs, and the queue hook in shell/agentic-intellij.sh runs the next queued
command in each new terminal there. If a directory has more sessions than
restored tabs, open another terminal tab in that window and the next session
starts in it.

save can run from inside an IntelliJ terminal, even from a Claude session: the
part that stops sessions and quits IntelliJ detaches first, so it survives.

Saving one bench is for changing its .idea/ while IntelliJ is closed on it,
such as switching it to BSP:
  bench save <dir> && intellij-bsp <dir> && bench restore <dir>
A bench's save is kept apart from the whole-IDE one, so each restore brings
back what its own save recorded.
"""
import hashlib, json, os, shlex, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".cache", "bench")
OLD_STATE_DIR = os.path.join(HOME, ".cache", "intellij-sessions")  # before the rename
STATE = os.path.join(STATE_DIR, "state.json")
PROJECT_STATES = os.path.join(STATE_DIR, "projects")
LOG = os.path.join(HOME, "logs", "bench.log")
PENDING = os.path.join(STATE_DIR, "pending")
OLD_PENDING = os.path.join(HOME, ".cache", "load-project", "pending")  # before load-project went
SESSIONS = os.path.join(HOME, ".claude", "sessions")
INTELLIJ = os.path.join(os.path.dirname(os.path.realpath(__file__)), "intellij")
BUNDLE_ID = "com.jetbrains.intellij"
IDE_RE = "/Contents/MacOS/idea"

# A command eval'd while the shell rc file is still
# sourcing runs before direnv's hook, so the project's .envrc is loaded here.
DIRENV = 'if command -v direnv >/dev/null 2>&1; then eval "$(direnv export ${ZSH_VERSION:+zsh}${BASH_VERSION:+bash})"; fi; '

# Options that pick or name the session; restore supplies its own.
DROP_WITH_VALUE = {"-n", "--name", "--session-id"}
DROP_OPTIONAL_VALUE = {"-r", "--resume"}
DROP_FLAG = {"-c", "--continue", "--fork-session"}


def sh(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def say(msg):
    print(f"bench: {msg}", flush=True)


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")


def notify(msg):
    subprocess.run(["osascript", "-e",
                    f"display notification {json.dumps(msg)} with title \"bench\""],
                   capture_output=True)


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def ancestors(pid):
    seen = []
    while pid > 1:
        seen.append(pid)
        out = sh("ps", "-o", "ppid=", "-p", str(pid)).strip()
        pid = int(out) if out.isdigit() else 0
    return seen


def ide_pids():
    out = sh("ps", "-axo", "pid=,command=")
    return [int(l.split(None, 1)[0]) for l in out.splitlines()
            if IDE_RE in l and "IntelliJ IDEA" in l and l.split(None, 1)[1].split(IDE_RE)[1][:1] in ("", " ")]


def queue_key(path):
    # The queue hook (shell/agentic-intellij.sh) keys on `printf '%s' "$(pwd -P)" | shasum`.
    return hashlib.sha1(os.path.realpath(path).encode()).hexdigest()


def clean_args(argv):
    """Drop the options that select or name a session; keep everything else."""
    kept, i = [], 0
    while i < len(argv):
        a = argv[i]
        name = a.split("=", 1)[0]
        if name in DROP_FLAG:
            i += 1
        elif name in DROP_WITH_VALUE:
            i += 1 if "=" in a else 2
        elif name in DROP_OPTIONAL_VALUE:
            i += 1
            if "=" not in a and i < len(argv) and not argv[i].startswith("-"):
                i += 1
        else:
            kept.append(a)
            i += 1
    return kept


def running_sessions():
    """Claude sessions in IntelliJ terminals, from Claude's per-process records."""
    found = []
    # -a: macOS pgrep otherwise skips its own ancestors, i.e. the session running this.
    for pid in sh("pgrep", "-a", "-x", "claude").split():
        pid = int(pid)
        rec_path = os.path.join(SESSIONS, f"{pid}.json")
        if not os.path.exists(rec_path):
            continue
        if "TERMINAL_EMULATOR=JetBrains-JediTerm" not in sh("ps", "eww", "-o", "command=", "-p", str(pid)):
            continue
        rec = json.load(open(rec_path))
        argv = sh("ps", "-o", "args=", "-p", str(pid)).split()
        if not argv or not rec.get("sessionId"):
            continue
        cwd = rec.get("cwd") or ""
        cmd = [argv[0]] + clean_args(argv[1:]) + ["--resume", rec["sessionId"]]
        if rec.get("name"):
            cmd += ["-n", rec["name"]]
        line = " ".join(shlex.quote(c) for c in cmd)
        if os.path.exists(os.path.join(cwd, ".envrc")):
            line = DIRENV + line
        found.append({"pid": pid, "name": rec.get("name"), "sessionId": rec["sessionId"],
                      "cwd": cwd, "status": rec.get("status"), "command": line})
    return sorted(found, key=lambda s: (s["cwd"], s["name"] or ""))


def load(path):
    with open(path) as f:
        return json.load(f)


def tilde(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def table(sessions, saved=False):
    for s in sessions:
        status = s.get("status") or ""
        if saved and not os.path.isdir(s["cwd"]):
            status = "gone"
        print(f"  {s['name'] or '(unnamed)':24} {status:6} {tilde(s['cwd'])}")


def project_state(project):
    return os.path.join(PROJECT_STATES, queue_key(project) + ".json")


def in_project(cwd, project):
    cwd = os.path.realpath(cwd) if cwd else ""
    return cwd == project or cwd.startswith(project + "/")


def project_name(project):
    """The name IntelliJ usually puts at the start of the window title: the
    directory's name. .idea/.name, when present, may be the title instead, so
    window() matches either."""
    return os.path.basename(project)


def idea_name(project):
    try:
        with open(os.path.join(project, ".idea", ".name")) as f:
            return f.readline().strip() or project_name(project)
    except OSError:
        return project_name(project)


# Find the project's window: a title with its bracketed ~-path wins over one
# starting with its directory's name or its .idea/.name; two windows matching by name
# alone is "ambiguous", and nothing is touched. "terminal" raises the window
# and toggles its Terminal (alt-F12); "close" raises it and runs
# File > Close Project.
WINDOW_OSA = '''on run argv
  set marker to "[" & (item 1 of argv) & "]"
  set pname to item 2 of argv
  set act to item 3 of argv
  set iname to item 4 of argv
  tell application "System Events"
    if not (exists process "idea") then return "no"
    tell process "idea"
      set w to missing value
      set nmatch to 0
      repeat with i from 1 to count of windows
        set x to window i
        set t to name of x
        if t contains marker then
          set w to x
          set nmatch to 1
          exit repeat
        end if
        if t is pname or t starts with (pname & " ") or t is iname or t starts with (iname & " ") then
          set w to x
          set nmatch to nmatch + 1
        end if
      end repeat
      if w is missing value then return "no"
      if nmatch > 1 then return "ambiguous"
      if act is "find" then return "yes"
      perform action "AXRaise" of w
      set frontmost to true
      delay 0.5
      if act is "close" then click menu item "Close Project" of menu 1 of menu bar item "File" of menu bar 1
      if act is "terminal" then key code 111 using {option down}
    end tell
  end tell
  return "yes"
end run'''


def window(project, act="find"):
    """"yes", "no" or "ambiguous"; see WINDOW_OSA."""
    r = subprocess.run(["osascript", "-", tilde(project), project_name(project), act, idea_name(project)],
                       input=WINDOW_OSA, capture_output=True, text=True)
    if r.returncode:
        log(f"osascript ({act} {tilde(project)}) failed: {r.stderr.strip()}")
    return r.stdout.strip() or "no"


# ---------------------------------------------------------------- save

def save(dry, force, project=None):
    if not ide_pids():
        say("IntelliJ isn't running; nothing to save")
        return 1
    if project:
        return save_project(dry, force, project)
    sessions = running_sessions()
    mine = set(ancestors(os.getpid()))
    busy = [s for s in sessions if s["status"] == "busy" and s["pid"] not in mine]
    say(f"{len(sessions)} Claude session(s) in IntelliJ terminals:")
    table(sessions)
    if busy and not force:
        say("these sessions are busy; let them finish or pass --force: "
            + ", ".join(s["name"] or str(s["pid"]) for s in busy))
        return 1
    if dry:
        say("dry run: restore would queue these commands")
        for s in sessions:
            print(f"  [{tilde(s['cwd'])}] {s['command']}")
        return 0

    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.exists(STATE):
        os.replace(STATE, STATE + ".prev")
    with open(STATE, "w") as f:
        json.dump({"savedAt": time.strftime("%Y-%m-%dT%H:%M:%S"), "sessions": sessions}, f, indent=2)
    say(f"saved to {tilde(STATE)}")
    log(f"saved {len(sessions)} session(s)")

    if any(p in mine for p in ide_pids()) or any(s["pid"] in mine for s in sessions):
        # Quitting IntelliJ ends this terminal; finish from a detached process.
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "_quit"],
                         stdin=subprocess.DEVNULL, stdout=open(LOG, "a"), stderr=subprocess.STDOUT,
                         start_new_session=True)
        say("closing sessions and IntelliJ in the background; this terminal ends with them")
        say("when it's done, run: bench restore")
        return 0
    return quit_all()


def save_project(dry, force, project):
    found = window(project)
    if found != "yes":
        say(f"no IntelliJ window for {tilde(project)}" if found == "no" else
            f"more than one IntelliJ window is named {project_name(project)}; close {tilde(project)} "
            "yourself (File > Close Project)")
        return 1
    sessions = [s for s in running_sessions() if in_project(s["cwd"], project)]
    mine = set(ancestors(os.getpid()))
    busy = [s for s in sessions if s["status"] == "busy" and s["pid"] not in mine]
    say(f"{len(sessions)} Claude session(s) in {tilde(project)}:")
    table(sessions)
    if busy and not force:
        say("these sessions are busy; let them finish or pass --force: "
            + ", ".join(s["name"] or str(s["pid"]) for s in busy))
        return 1
    if dry:
        say(f"dry run: would close the {project_name(project)} window; restore would queue these commands")
        for s in sessions:
            print(f"  [{tilde(s['cwd'])}] {s['command']}")
        return 0

    path = project_state(project)
    os.makedirs(PROJECT_STATES, exist_ok=True)
    with open(path, "w") as f:
        json.dump({"savedAt": time.strftime("%Y-%m-%dT%H:%M:%S"), "project": project,
                   "sessions": sessions}, f, indent=2)
    say(f"saved to {tilde(path)}")
    log(f"saved {len(sessions)} session(s) for {tilde(project)}")

    if any(s["pid"] in mine for s in sessions) or in_project(os.getcwd(), project):
        # This terminal may be in the window being closed; finish detached.
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "_close", project],
                         stdin=subprocess.DEVNULL, stdout=open(LOG, "a"), stderr=subprocess.STDOUT,
                         start_new_session=True)
        say("closing the window in the background; a terminal in it ends with it")
        say(f"when it's done, run: bench restore {tilde(project)}")
        return 0
    return close_project(project)


def close_project(project):
    """Close the project's window; its terminals closing ends its sessions.
    As with quit_all, sessions are never stopped directly."""
    time.sleep(2)  # let a calling session print its last words
    window(project, "close")
    deadline = time.time() + 30
    while time.time() < deadline and window(project) != "no":
        time.sleep(1)
    if window(project) != "no":
        msg = (f"The {project_name(project)} window is still open (a dialog may be waiting). "
               "Its sessions are still running; nothing was stopped. Close it yourself "
               f"(File > Close Project), then run: bench restore {tilde(project)}")
        rc = 1
    else:
        msg = f"Closed {tilde(project)}. Run: bench restore {tilde(project)}"
        rc = 0
    log(msg)
    notify(msg)
    print(msg)
    return rc


def osa(script):
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode:
        log(f"osascript failed ({r.returncode}): {r.stderr.strip()}")
    return r.returncode == 0


def wait_gone(seconds):
    deadline = time.time() + seconds
    while time.time() < deadline and ide_pids():
        time.sleep(1)
    return not ide_pids()


def quit_all():
    """Quit IntelliJ; its terminals closing is what ends the Claude sessions.

    Sessions are never stopped directly: if IntelliJ refuses to quit, every
    session keeps running and nothing is lost.
    """
    time.sleep(2)  # let a calling session print its last words
    sessions = load(STATE)["sessions"]

    log("asking IntelliJ to quit (AppleScript)")
    osa(f'tell application id "{BUNDLE_ID}" to quit')
    gone = wait_gone(20)
    if not gone and ide_pids():
        log("no exit after 20s; sending cmd-Q to IntelliJ")
        osa('tell application "System Events" to tell process "idea"\n'
            '  set frontmost to true\n'
            '  keystroke "q" using {command down}\n'
            'end tell')
        gone = wait_gone(100)

    if gone:
        msg = f"IntelliJ closed with {len(sessions)} session(s) saved. Run: bench restore"
    else:
        msg = ("IntelliJ didn't quit (a dialog may be waiting). Your Claude sessions are "
               "still running; nothing was stopped. Quit IntelliJ yourself, then run: "
               "bench restore")
    log(msg)
    notify(msg)
    print(msg)
    return 0


# ---------------------------------------------------------------- restore

def raise_terminal(path):
    """Raise the project's window and show its Terminal (alt-F12)."""
    return window(path, "terminal") == "yes"


def queued(path):
    try:
        with open(os.path.join(PENDING, queue_key(path))) as f:
            return len([l for l in f if l.strip()])
    except FileNotFoundError:
        return 0


def saved_for(project):
    """The newer of the project's own save and its part of the whole-IDE save,
    as (savedAt, sessions); None when neither has it."""
    found = []
    path = project_state(project)
    if os.path.exists(path):
        st = load(path)
        found.append((st["savedAt"], st["sessions"]))
    if os.path.exists(STATE):
        st = load(STATE)
        mine = [s for s in st["sessions"] if in_project(s["cwd"], project)]
        if mine:
            found.append((st["savedAt"], mine))
    return max(found, key=lambda f: f[0]) if found else None


def new_session(project, args):
    """A command that starts a new session named after the project. Without
    args, BENCH_CLAUDE_ARGS supplies the flags."""
    if not args:
        args = shlex.split(os.environ.get("BENCH_CLAUDE_ARGS", ""))
    line = " ".join(shlex.quote(a) for a in ["claude", *args, "-n", project_name(project)])
    if os.path.exists(os.path.join(project, ".envrc")):
        line = DIRENV + line
    return {"name": project_name(project), "sessionId": None, "cwd": project,
            "status": "new", "command": line}


def direnv_blocked(path):
    """True when the directory's .envrc exists and direnv hasn't approved it.
    Approving one is the operator's call, so restore only warns."""
    if not os.path.exists(os.path.join(path, ".envrc")):
        return False
    try:
        out = subprocess.run(["direnv", "status", "--json"], cwd=path, capture_output=True, text=True).stdout
        rc = (json.loads(out).get("state") or {}).get("foundRC") or {}
    except (OSError, ValueError):
        return False
    return bool(rc) and rc.get("allowed") != 0


def restore(dry, project=None, start_new=False, args=()):
    """Restore every bench, or one project's. With start_new (bench open), a
    project with nothing saved gets a new session instead."""
    if project:
        saved = saved_for(project)
        if saved is None and not start_new:
            say(f"nothing saved for {tilde(project)}; to start a new session there, run: "
                f"bench open {tilde(project)}")
            return 1
        saved_at, sessions = saved or (None, [])
    else:
        if not os.path.exists(STATE):
            say(f"nothing saved yet ({tilde(STATE)})")
            return 1
        st = load(STATE)
        saved_at, sessions = st["savedAt"], st["sessions"]
    live = {s["sessionId"] for s in running_sessions()}
    by_dir, skipped = {}, []
    for s in sessions:
        if s["sessionId"] in live:
            skipped.append(f"{s['name'] or s['sessionId']} (already running)")
        elif not os.path.isdir(s["cwd"]):
            skipped.append(f"{s['name'] or s['sessionId']} (directory gone: {tilde(s['cwd'])}; "
                           "bench prune drops it)")
        else:
            by_dir.setdefault(s["cwd"], []).append(s)
    if project and start_new and not sessions:
        s = new_session(project, args)
        by_dir[project] = [s]
        say(f"nothing saved for {tilde(project)}; starting a new session:")
    else:
        say(f"restoring {sum(map(len, by_dir.values()))} session(s) saved {saved_at}:")
    table([s for ss in by_dir.values() for s in ss])
    for k in skipped:
        say(f"skipping {k}")
    for d in by_dir:
        if direnv_blocked(d):
            say(f"{tilde(d)}/.envrc is not approved, so its sessions start without the "
                f"project environment; to approve it: direnv allow {tilde(d)}")
    if dry:
        for d, ss in by_dir.items():
            for s in ss:
                print(f"  [{tilde(d)}] {s['command']}")
        return 0
    if not by_dir and not project:
        return 0
    # Fail before queueing: a command left queued with no IDE to open it would
    # run in the next unrelated terminal in that directory.
    if subprocess.run([INTELLIJ, "--which"], capture_output=True).returncode:
        say("no IntelliJ found; run: intellij --which")
        return 1
    if not by_dir:
        subprocess.run([INTELLIJ, project])  # reopen the window; it had no sessions
        return 0

    # Only a window that is already open misses the queue: a project IntelliJ
    # opens now restores its terminal tabs, and they take the queued commands.
    already_open = window(project) != "no" if project else bool(ide_pids())
    os.makedirs(PENDING, exist_ok=True)
    for d, ss in by_dir.items():
        with open(os.path.join(PENDING, queue_key(d)), "w") as f:
            f.write("".join(s["command"] + "\n" for s in ss))
    # A session can run in a subdirectory; open the project, not that.
    subprocess.run([INTELLIJ, *([project] if project else by_dir)])

    if already_open:
        # Open windows don't get fresh terminal tabs, so nothing picks up the queue by itself.
        say("IntelliJ was already open, so open a new terminal tab (⌘T in the Terminal) "
            "in each window below; each new tab resumes the next queued session:")
        for d, ss in by_dir.items():
            say(f"  {tilde(d)}: {len(ss)} tab(s) ({', '.join(s['name'] or s['sessionId'] for s in ss)})")
        log(f"queued {sum(map(len, by_dir.values()))} with IntelliJ already open")
        return 0

    # Restored terminal tabs take the queued commands. A project whose queue is
    # untouched a while after IntelliJ came up gets its Terminal opened once.
    start, poked = time.time(), set()
    while time.time() - start < 240 and any(queued(d) for d in by_dir):
        time.sleep(3)
        if time.time() - start > 60:
            for d in by_dir:
                if d not in poked and queued(d) == len(by_dir[d]) and raise_terminal(project or d):
                    poked.add(d)
    left = {d: queued(d) for d in by_dir if queued(d)}
    done = sum(map(len, by_dir.values())) - sum(left.values())
    say(f"{done} session(s) started")
    for d, n in left.items():
        say(f"{n} still queued for {tilde(d)}: open a terminal tab in that window "
            "and each new tab starts the next one")
    log(f"restored {done}, still queued {sum(left.values())}")
    return 0 if not left else 2


# ---------------------------------------------------------------- show

def show():
    now = running_sessions()
    say(f"running now in IntelliJ terminals ({len(now)}):")
    table(now)
    if os.path.exists(STATE):
        st = load(STATE)
        say(f"last saved {st['savedAt']} ({len(st['sessions'])}):")
        table(st["sessions"], saved=True)
    else:
        say("nothing saved yet")
    if os.path.isdir(PROJECT_STATES):
        for name in sorted(os.listdir(PROJECT_STATES)):
            st = load(os.path.join(PROJECT_STATES, name))
            say(f"saved {st['savedAt']} for {tilde(st['project'])} ({len(st['sessions'])}):")
            table(st["sessions"], saved=True)
    return 0


# ---------------------------------------------------------------- prune

def prune(dry):
    """Drop saved sessions whose directory is gone, and project saves left
    with none or whose project is gone."""
    drops = 0
    if os.path.exists(STATE):
        st = load(STATE)
        gone = [s for s in st["sessions"] if not os.path.isdir(s["cwd"])]
        if gone:
            say(f"{'would drop' if dry else 'dropping'} from the whole-IDE save:")
            table(gone)
            drops += len(gone)
            if not dry:
                st["sessions"] = [s for s in st["sessions"] if s not in gone]
                with open(STATE, "w") as f:
                    json.dump(st, f, indent=2)
    if os.path.isdir(PROJECT_STATES):
        for name in sorted(os.listdir(PROJECT_STATES)):
            path = os.path.join(PROJECT_STATES, name)
            st = load(path)
            gone = [s for s in st["sessions"] if not os.path.isdir(s["cwd"])]
            if not os.path.isdir(st["project"]) or (gone and len(gone) == len(st["sessions"])):
                say(f"{'would delete' if dry else 'deleting'} the save for {tilde(st['project'])}:")
                table(st["sessions"])
                drops += len(st["sessions"]) or 1
                if not dry:
                    os.remove(path)
            elif gone:
                say(f"{'would drop' if dry else 'dropping'} from the save for {tilde(st['project'])}:")
                table(gone)
                drops += len(gone)
                if not dry:
                    st["sessions"] = [s for s in st["sessions"] if s not in gone]
                    with open(path, "w") as f:
                        json.dump(st, f, indent=2)
    if not drops:
        say("every saved directory still exists; nothing to prune")
    elif not dry:
        log(f"pruned {drops}")
    return 0


# ---------------------------------------------------------------- names

def saved_sessions():
    """Every saved and running session, as (session, project dir)."""
    out = [(s, s["cwd"]) for s in running_sessions()]
    if os.path.exists(STATE):
        out += [(s, s["cwd"]) for s in load(STATE)["sessions"]]
    if os.path.isdir(PROJECT_STATES):
        for name in os.listdir(PROJECT_STATES):
            st = load(os.path.join(PROJECT_STATES, name))
            out += [(s, st["project"]) for s in st["sessions"]]
    return out


def resolve(arg):
    """A directory, or a name: a session's -n name, else a project directory's
    name, exact before case-insensitive. Returns (path, error)."""
    path = os.path.expanduser(arg)
    if os.path.isdir(path):
        return os.path.realpath(path), None
    known = saved_sessions()
    for same in (str.__eq__, lambda a, b: a.lower() == b.lower()):
        for key in (lambda s, d: s.get("name") or "", lambda s, d: os.path.basename(d)):
            dirs = sorted({d for s, d in known if same(key(s, d), arg)})
            if len(dirs) == 1:
                return os.path.realpath(dirs[0]), None
            if len(dirs) > 1:
                return None, f"{arg} names more than one directory; give one of: " + \
                    ", ".join(map(tilde, dirs))
    names = sorted({s.get("name") for s, d in known if s.get("name")}, key=str.lower)
    return None, f"{arg}: not a directory or a saved session's name. Known: {' '.join(names)}"


def move_old_state():
    """Carry state made under old names across once: saves from
    intellij-sessions, and the queue load-project kept."""
    if os.path.isdir(OLD_STATE_DIR) and not os.path.exists(STATE_DIR):
        os.rename(OLD_STATE_DIR, STATE_DIR)
    if os.path.isdir(OLD_PENDING):
        os.makedirs(PENDING, exist_ok=True)
        for name in os.listdir(OLD_PENDING):
            if name.endswith(".lock"):
                continue
            src, dst = os.path.join(OLD_PENDING, name), os.path.join(PENDING, name)
            with open(src) as f, open(dst, "a") as g:
                g.write(f.read())
            os.remove(src)
        try:
            os.rmdir(OLD_PENDING)
            os.rmdir(os.path.dirname(OLD_PENDING))
        except OSError:
            pass


def main(argv):
    move_old_state()
    cmd = argv[0] if argv else "show"
    rest, claude_args = argv[1:], []
    if "--" in rest:
        rest, claude_args = rest[:rest.index("--")], rest[rest.index("--") + 1:]
    flags = {a for a in rest if a.startswith("-")}
    paths = [a for a in rest if not a.startswith("-")]
    if (len(paths) > 1 or (paths and cmd not in ("save", "restore", "open", "_close"))
            or (cmd == "open" and not paths) or (claude_args and cmd != "open")):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    project = None
    if paths:
        project, err = resolve(paths[0])
        if err:
            say(err)
            return 1
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd == "save":
        return save("--dry-run" in flags or "-n" in flags, "--force" in flags, project)
    if cmd == "restore":
        return restore("--dry-run" in flags or "-n" in flags, project)
    if cmd == "open":
        return restore("--dry-run" in flags or "-n" in flags, project, True, claude_args)
    if cmd == "prune":
        return prune("--dry-run" in flags or "-n" in flags)
    if cmd == "show":
        return show()
    if cmd == "_quit":
        return quit_all()
    if cmd == "_close" and project:
        return close_project(project)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
