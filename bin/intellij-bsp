#!/usr/bin/env python3
"""intellij-bsp: switch IntelliJ projects from sbt import to BSP, so the IDE
shares each checkout's one sbt server (see sbt-bsp) instead of running
its own sbt shell.

Usage:
  intellij-bsp [--dry-run] <project dir> ...
  intellij-bsp [--dry-run] --all      every project in the last `intellij-sessions save`
  intellij-bsp --undo <project dir> ...

The project must not be open in IntelliJ, since the IDE rewrites .idea/ when it
closes a project. Close its window (File > Close Project), or quit IntelliJ with
`intellij-sessions save`, first.

For each sbt build linked in .idea/sbt.xml, it runs sbt-bsp-setup (so
.bsp/sbt.json runs sbt-bsp, and the team's .idea/sbt.xml is hidden from
git), writes .idea/bsp.xml pointing at that connection file, and moves
.idea/sbt.xml aside to .idea/sbt.xml.pre-bsp. It also drops the modules the
sbt import created from .idea/modules.xml (saved first as modules.xml.pre-bsp):
left in place, they keep claiming the source folders, and the Scala plugin
reports "Code insight is unavailable because the sbt project is not loaded".
The .iml files stay on disk. IntelliJ loads the build over BSP the next time it
opens the project.

A checkout IntelliJ has never opened (no .idea/workspace.xml) and with no
.idea/sbt.xml, such as a new worktree of a repository that doesn't keep .idea
in git, gets the same treatment for the sbt builds found on disk: the
checkout's root and one or two levels down, as sbt-bsp-setup finds them. So a
worktree tool can run it before the first open, and IntelliJ imports the
checkout over BSP from the start. A checkout IntelliJ has opened without
linking sbt is left alone.

Run it again on a project that is already on BSP to drop sbt modules left over
from an earlier switch. --undo moves sbt.xml and modules.xml back and removes
bsp.xml.
"""
import glob, json, os, re, subprocess, sys
from xml.etree import ElementTree as ET

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".cache", "intellij-sessions", "state.json")
SETUP = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sbt-bsp-setup")

BSP_XML = """<?xml version="1.0" encoding="UTF-8"?>
<project version="4">
  <component name="BspSettings">
    <option name="linkedExternalProjectsSettings">
{settings}
    </option>
  </component>
</project>
"""
BSP_PROJECT = """      <BspProjectSettings>
        <option name="externalProjectPath" value="{rel}" />
        <option name="modules">
          <set>
            <option value="{rel}" />
          </set>
        </option>
        <option name="preImportConfig" value="NoPreImport" />
        <option name="serverConfig" value="BspConfigFile:{conn}" />
      </BspProjectSettings>"""


def say(msg):
    print(f"intellij-bsp: {msg}")


def tilde(path):
    return "~" + path[len(HOME):] if path.startswith(HOME + "/") else path


RECENT = os.path.join(HOME, "Library", "Application Support", "JetBrains")


def ide_running():
    ps = subprocess.run(["ps", "-axo", "command="], capture_output=True, text=True).stdout
    return any(re.search(r"/IntelliJ IDEA[^/]*\.app/Contents/MacOS/idea( |$)", l) for l in ps.splitlines())


def open_in_ide(project):
    """True when IntelliJ has this project open. Window titles show only the
    project's name ("backend – Foo.scala"), not its path, so map the path to a
    name through IntelliJ's recent-projects list (opened="true", frameTitle),
    then look for a window with that name. The list is saved only now and then,
    so a project closed a minute ago still reads opened="true" there; the window
    check catches that. Two open projects with the same name both read as open,
    which errs on the safe side."""
    if not ide_running():
        return False
    files = sorted(
        (os.path.join(d, "options", "recentProjects.xml") for d in
         (os.path.join(RECENT, n) for n in os.listdir(RECENT) if n.startswith("IntelliJIdea"))),
        key=lambda f: os.path.getmtime(f) if os.path.exists(f) else 0)
    if not files or not os.path.exists(files[-1]):
        sys.exit("intellij-bsp: can't find IntelliJ's recentProjects.xml to tell which projects are open")
    for e in ET.parse(files[-1]).getroot().iter("entry"):
        meta = e.find("value/RecentProjectMetaInfo")
        key = (e.get("key") or "").replace("$USER_HOME$", HOME)
        if meta is not None and meta.get("opened") == "true" and os.path.realpath(key) == project:
            name = re.split(r" \[| – ", meta.get("frameTitle") or "")[0].strip()
            return not name or any(t == name or t.startswith(name + " ") for t in window_titles())
    return False


def window_titles():
    out = subprocess.run(["osascript", "-e",
        'tell application "System Events" to tell process "idea" to get name of windows'],
        capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"intellij-bsp: can't read IntelliJ's window titles: {out.stderr.strip()}")
    return [t.strip() for t in out.stdout.strip().split(", ")]


def linked_builds(sbt_xml, project):
    """Absolute paths of the sbt builds .idea/sbt.xml links."""
    root = ET.parse(sbt_xml).getroot()
    paths = [o.get("value") for o in root.iter("option") if o.get("name") == "externalProjectPath"]
    return [os.path.normpath(p.replace("$PROJECT_DIR$", project)) for p in paths]


SKIP_RE = re.compile(r"/(target|target-test|node_modules|project)/")


def builds_on_disk(project):
    """sbt builds in the checkout's root and one or two levels down, skipping
    build output and node_modules: the same places sbt-bsp-setup looks."""
    found = []
    base = glob.escape(project)
    for d in [project + "/"] + sorted(glob.glob(base + "/*/")) + sorted(glob.glob(base + "/*/*/")):
        if SKIP_RE.search(d[len(project):]):
            continue
        d = d.rstrip("/")
        if os.path.isfile(os.path.join(d, "build.sbt")) and os.path.isfile(os.path.join(d, "project", "build.properties")):
            found.append(d)
    return found


MODULE_RE = re.compile(r'^[ \t]*<module\b[^>]*\bfilepath="([^"]*)"[^>]*/>[ \t]*\n?', re.M)


def sbt_modules(project):
    """(modules.xml text, its <module/> lines that point at .iml files the sbt
    import owns), or (None, []) when there is no modules.xml."""
    path = os.path.join(project, ".idea", "modules.xml")
    if not os.path.isfile(path):
        return None, []
    with open(path) as f:
        text = f.read()
    stale = []
    for m in MODULE_RE.finditer(text):
        iml = m.group(1).replace("$PROJECT_DIR$", project)
        try:
            system = ET.parse(iml).getroot().get("external.system.id")
        except (OSError, ET.ParseError):
            continue
        if system == "SBT":
            stale.append(m.group(0))
    return text, stale


def drop_sbt_modules(project, dry):
    """Remove the sbt import's modules from .idea/modules.xml."""
    path = os.path.join(project, ".idea", "modules.xml")
    text, stale = sbt_modules(project)
    if not stale:
        return
    tracked = subprocess.run(["git", "-C", project, "ls-files", "--error-unmatch", ".idea/modules.xml"],
                             capture_output=True).returncode == 0
    if tracked:
        say(f"  .idea/modules.xml is tracked by git; not dropping its {len(stale)} sbt modules "
            "(remove them in File > Project Structure > Modules)")
        return
    names = [os.path.basename(MODULE_RE.match(l).group(1)) for l in stale]
    say(f"  {'would drop' if dry else 'dropping'} {len(stale)} sbt import modules from .idea/modules.xml: {', '.join(names)}")
    if dry:
        return
    backup = path + ".pre-bsp"
    if not os.path.exists(backup):
        with open(backup, "w") as f:
            f.write(text)
    for line in stale:
        text = text.replace(line, "", 1)
    with open(path, "w") as f:
        f.write(text)


def convert(project, dry):
    idea = os.path.join(project, ".idea")
    sbt_xml, bsp_xml = os.path.join(idea, "sbt.xml"), os.path.join(idea, "bsp.xml")
    if not os.path.isdir(project):
        say(f"{tilde(project)}: not a directory")
        return False
    linked = os.path.isfile(sbt_xml)
    if linked:
        builds = linked_builds(sbt_xml, project)
        if not builds:
            say(f"{tilde(project)}: .idea/sbt.xml links no build; leaving it")
            return True
        # sbt-bsp-setup only prepares builds with both files; any other would
        # be linked to a .bsp/sbt.json that doesn't run sbt-bsp.
        missing = [b for b in builds if not (os.path.isfile(os.path.join(b, "build.sbt"))
                                             and os.path.isfile(os.path.join(b, "project", "build.properties")))]
        if missing:
            say(f"{tilde(project)}: linked build has no build.sbt or project/build.properties: "
                f"{', '.join(map(tilde, missing))}")
            return False
    elif os.path.isfile(bsp_xml):
        if not sbt_modules(project)[1]:
            say(f"{tilde(project)}: already on BSP")
            return True
        if open_in_ide(project):
            say(f"{tilde(project)}: already on BSP but has sbt import modules left; close it first (File > Close Project)")
            return False
        say(f"{tilde(project)}: already on BSP")
        drop_sbt_modules(project, dry)
        return True
    elif os.path.isfile(os.path.join(idea, "workspace.xml")):
        found = builds_on_disk(project)
        say(f"{tilde(project)}: opened in IntelliJ without an sbt link; leaving it"
            + (f" (sbt builds here: {', '.join(map(tilde, found))}; to switch, link sbt in"
               " IntelliJ's sbt tool window, close the project and rerun)" if found else ""))
        return True
    else:
        builds = builds_on_disk(project)
        if not builds:
            say(f"{tilde(project)}: no .idea/sbt.xml and no sbt build found; nothing to do")
            return True
    if open_in_ide(project):
        say(f"{tilde(project)}: open in IntelliJ; close it first (File > Close Project)")
        return False

    settings = []
    for b in builds:
        rel = "$PROJECT_DIR$" + b[len(project):]
        settings.append(BSP_PROJECT.format(rel=rel, conn=os.path.join(b, ".bsp", "sbt.json")))
    text = BSP_XML.format(settings="\n".join(settings))

    say(f"{tilde(project)}: builds {', '.join(tilde(b) for b in builds)}")
    if dry:
        say("  would run sbt-bsp-setup, write .idea/bsp.xml"
            + (", move .idea/sbt.xml to sbt.xml.pre-bsp" if linked else ""))
        print(text)
        drop_sbt_modules(project, dry)
        return True
    subprocess.run([SETUP, project], check=True)
    os.makedirs(idea, exist_ok=True)
    if os.path.exists(bsp_xml):
        os.replace(bsp_xml, bsp_xml + ".bak")
    with open(bsp_xml, "w") as f:
        f.write(text)
    if linked:
        os.replace(sbt_xml, sbt_xml + ".pre-bsp")
        say("  wrote .idea/bsp.xml; .idea/sbt.xml is now sbt.xml.pre-bsp")
    else:
        say("  wrote .idea/bsp.xml")
    drop_sbt_modules(project, dry)
    return True


def undo(project, dry):
    idea = os.path.join(project, ".idea")
    saved, sbt_xml, bsp_xml, modules, modules_saved = (os.path.join(idea, n) for n in (
        "sbt.xml.pre-bsp", "sbt.xml", "bsp.xml", "modules.xml", "modules.xml.pre-bsp"))
    if not os.path.isfile(saved):
        say(f"{tilde(project)}: nothing to undo (no .idea/sbt.xml.pre-bsp)")
        return True
    if open_in_ide(project):
        say(f"{tilde(project)}: open in IntelliJ; close it first (File > Close Project)")
        return False
    also = " and .idea/modules.xml" if os.path.isfile(modules_saved) else ""
    say(f"{tilde(project)}: {'would restore' if dry else 'restoring'} .idea/sbt.xml{also} and remove .idea/bsp.xml")
    if not dry:
        os.replace(saved, sbt_xml)
        if also:
            os.replace(modules_saved, modules)
        if os.path.exists(bsp_xml):
            os.remove(bsp_xml)
    return True


def main(argv):
    dry = "--dry-run" in argv or "-n" in argv
    rollback = "--undo" in argv
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    args = [a for a in argv if not a.startswith("-")]
    if "--all" in argv:
        # Saved sessions can outlive their worktrees; skip those rather than fail.
        with open(STATE) as f:
            saved = sorted({s["cwd"] for s in json.load(f)["sessions"]})
        for gone in (d for d in saved if not os.path.isdir(d)):
            say(f"{tilde(gone)}: no longer exists; skipping")
        args += [d for d in saved if os.path.isdir(d)]
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    ok = True
    for a in dict.fromkeys(os.path.realpath(os.path.expanduser(a)) for a in args):
        ok &= (undo if rollback else convert)(a, dry)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
